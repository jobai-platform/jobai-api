APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/jobai
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/jobai
JWT_SECRET=changeme
PASSWORD_RESET_SIGNING_KEY=changeme
OPENAI_API_KEY=
STRIPE_SECRET=
SLACK_WEBHOOK_URL=
# Resend transactional email
# Non-production key selected for dev, develop, and preview.
RESEND_API_KEY_SANDBOX=
# Production-only key selected when APP_ENV=production.
RESEND_API_KEY_PROD=
# Optional backward-compatible fallback.
RESEND_API_KEY=
RESEND_FROM_EMAIL=JobAI <onboarding@resend.dev>
RESEND_TIMEOUT=10.0
# Account-owner email used only by the opt-in sandbox integration test.
RESEND_SANDBOX_RECIPIENT=
# Use port 5433 to avoid conflict with a local Homebrew PostgreSQL on 5432
POSTGRES_PORT=5433
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5433/jobai_db
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:5001

# =============================================
# PREVIEW ENVIRONMENTS — GitHub Actions / Neon / Vercel
# =============================================
# These values are consumed by CI workflows, not by local Docker by default.
# Store real secrets in GitHub repository secrets or your secret manager.
NEON_PROJECT_ID=
NEON_PARENT_BRANCH=develop-anonymized
NEON_API_KEY=
PREVIEW_JWT_SECRET=
PREVIEW_TTL_DAYS=7
VERCEL_BACKEND_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_TOKEN=
VERCEL_BACKEND_PUBLIC_API_BASE_URL=
VERCEL_BRANCH_ENV_KEYS=

# =============================================
# AI PROVIDERS — Ollama (local inference)
# =============================================
# Ollama service URL.
# In Docker: http://ollama:11434
# Local dev (no Docker): http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Model used for generating vector embeddings (274 MB)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Model used for LLM completions (default: FAST tier)
# Options: mistral:7b (fast), mistral-nemo:12b (balanced), mistral:22b (precise)
OLLAMA_LLM_MODEL=mistral:7b

# HTTP timeout in seconds for Ollama API calls (LLM can be slow on CPU)
OLLAMA_TIMEOUT=120.0

# AI provider selection: "ollama" (default, local) or "openai" (cloud)
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama

# OpenAI fallback (leave empty to stay fully local)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# Ollama Docker port (exposed to host)
OLLAMA_PORT=11434

# =============================================
# LANGFUSE — LLM Observability (self-hosted)
# =============================================
# Langfuse web UI port (http://localhost:3000)
LANGFUSE_PORT=3000

# Secret keys — CHANGE in production
LANGFUSE_NEXTAUTH_SECRET=langfuse-secret-changeme
LANGFUSE_SALT=langfuse-salt-changeme

# API keys — generated from the Langfuse web UI after first login
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://langfuse:3000
