APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/jobai
JWT_SECRET=changeme
OPENAI_API_KEY=
STRIPE_SECRET=
SLACK_WEBHOOK_URL=
# Use port 5433 to avoid conflict with a local Homebrew PostgreSQL on 5432
POSTGRES_PORT=5433
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5433/jobai_db
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# =============================================
# AI PROVIDERS — Ollama (local inference)
# =============================================
# Ollama service URL.
# In Docker: http://ollama:11434
# Local dev (no Docker): http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Model used for generating vector embeddings (274 MB)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Model used for LLM completions (default: FAST tier)
# Options: mistral:7b (fast), mistral-nemo:12b (balanced), mistral:22b (precise)
OLLAMA_LLM_MODEL=mistral:7b

# HTTP timeout in seconds for Ollama API calls (LLM can be slow on CPU)
OLLAMA_TIMEOUT=120.0

# AI provider selection: "ollama" (default, local) or "openai" (cloud)
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama

# OpenAI fallback (leave empty to stay fully local)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# Ollama Docker port (exposed to host)
OLLAMA_PORT=11434

# =============================================
# LANGFUSE — LLM Observability (self-hosted)
# =============================================
# Langfuse web UI port (http://localhost:3000)
LANGFUSE_PORT=3000

# Secret keys — CHANGE in production
LANGFUSE_NEXTAUTH_SECRET=langfuse-secret-changeme
LANGFUSE_SALT=langfuse-salt-changeme

# API keys — generated from the Langfuse web UI after first login
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://langfuse:3000
