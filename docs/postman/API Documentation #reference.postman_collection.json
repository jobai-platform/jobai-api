        {
          "name": "Password Reset",
          "description": "JOB-102 password reset flow. Run 'Request Password Reset' first, copy the token from the received email into the password_reset_token collection variable, then run 'Reset Password'.",
          "item": [
            {
              "name": "Request Password Reset",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Returns 204 No Content\", function () {",
                      "    pm.response.to.have.status(204);",
                      "});",
                      "",
                      "pm.test(\"Response body is empty\", function () {",
                      "    pm.expect(pm.response.text()).to.eql(\"\");",
                      "});",
                      "",
                      "console.log(\"Copy the token received by email into the password_reset_token collection variable.\");"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"email\": \"{{reset_email}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/password/forgot",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "password",
                    "forgot"
                  ]
                },
                "description": "Requests a password reset email. The API always returns 204 for a syntactically valid email, whether or not the Candidate exists."
              },
              "response": []
            },
            {
              "name": "Reset Password",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Returns 204 No Content\", function () {",
                      "    pm.response.to.have.status(204);",
                      "});",
                      "",
                      "pm.test(\"Response body is empty\", function () {",
                      "    pm.expect(pm.response.text()).to.eql(\"\");",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"token\": \"{{password_reset_token}}\",\n    \"new_password\": \"{{new_password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/password/reset",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "password",
                    "reset"
                  ]
                },
                "description": "Consumes a valid reset token and replaces the Candidate password. Tokens expire after 30 minutes and can be used only once."
              },
              "response": []
            },
            {
              "name": "Reset Password - Invalid Token",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Returns 400 Bad Request\", function () {",
                      "    pm.response.to.have.status(400);",
                      "});",
                      "",
                      "pm.test(\"Returns the uniform token error\", function () {",
                      "    const body = pm.response.json();",
                      "    pm.expect(body.code).to.eql(\"bad_request\");",
                      "    pm.expect(body.detail).to.eql(\"Invalid or expired password reset token\");",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"token\": \"invalid-token\",\n    \"new_password\": \"{{new_password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/password/reset",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "password",
                    "reset"
                  ]
                },
                "description": "Verifies that invalid, expired, tampered, unknown, and consumed tokens share the same public error."
              },
              "response": []
            },
            {
              "name": "Reset Password - Weak Password",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Returns 422 Validation Error\", function () {",
                      "    pm.response.to.have.status(422);",
                      "});",
                      "",
                      "pm.test(\"Returns the standard validation envelope\", function () {",
                      "    const body = pm.response.json();",
                      "    pm.expect(body.code).to.eql(\"validation_error\");",
                      "    pm.expect(body.detail).to.eql(\"Request validation failed\");",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"token\": \"{{password_reset_token}}\",\n    \"new_password\": \"weak\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/auth/password/reset",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "password",
                    "reset"
                  ]
                },
                "description": "Verifies the D4 password policy: at least 12 characters, one uppercase letter, one digit, and one special character."
              },
              "response": []
            }
          ]
        }
      ]
